# Database (기본값 사용 시 생략 가능)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=insurance_ai
DB_USERNAME=insurance
DB_PASSWORD=password

# AI API Keys (필수)
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx

# JWT (필수 - 256bit 이상)
JWT_ACCESS_TOKEN_SECRET=your-access-token-secret-minimum-256-bits-long-string
JWT_REFRESH_TOKEN_SECRET=your-refresh-token-secret-minimum-256-bits-long-string

# Kakao OAuth (선택 - 미설정 시 빈 값으로 앱 기동 가능)
KAKAO_CLIENT_ID=your-kakao-app-key

# Server (기본값 사용 시 생략 가능)
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
