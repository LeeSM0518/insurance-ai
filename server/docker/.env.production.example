# Database
DB_HOST=insurance-database
DB_PORT=5432
DB_NAME=insurance_ai
DB_USERNAME=insurance
DB_PASSWORD=<strong-password>

# AI API Keys
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx

# JWT (openssl rand -base64 48 로 생성)
JWT_ACCESS_TOKEN_SECRET=<generated>
JWT_REFRESH_TOKEN_SECRET=<generated>

# Kakao OAuth
KAKAO_CLIENT_ID=<kakao-app-key>
KAKAO_CLIENT_SECRET=<kakao-client-secret>

# Server
CORS_ALLOWED_ORIGINS=https://your-domain.com
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# Domain (Nginx SSL)
DOMAIN=your-domain.com
CERTBOT_EMAIL=your-email@example.com

# Blue-Green 배포 (deploy.sh에서 관리, 수동 변경 불필요)
# ACTIVE_SLOT=blue
