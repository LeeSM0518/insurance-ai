  "components": {
    "schemas": {
      "SearchFilters": {
        "type": "object",
        "properties": {
          "companyIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "insuranceType": {
            "type": "string",
            "enum": [
              "LIFE",
              "NON_LIFE"
            ]
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contentTypes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "COVERAGE",
                "EXEMPTION",
                "REDUCTION",
                "QUALIFICATION",
                "SPECIAL_TERMS",
                "QNA",
                "COVERAGE_DETAIL",
                "CLAIM_DOCUMENTS",
                "ARTICLE"
              ]
            }
          }
        }
      },
      "SearchRequest": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "filters": {
            "$ref": "#/components/schemas/SearchFilters"
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "size": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "filters",
          "page",
          "query",
          "size"
        ]
      },
      "CompanyInfo": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "type"
        ]
      },
      "SearchResponse": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "totalCount": {
            "type": "integer",
            "format": "int32"
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "size": {
            "type": "integer",
            "format": "int32"
          },
          "hasNext": {
            "type": "boolean"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchResultItem"
            }
          }
        },
        "required": [
          "hasNext",
          "page",
          "query",
          "results",
          "size",
          "totalCount"
        ]
      },
      "SearchResultItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "insuranceCompany": {
            "$ref": "#/components/schemas/CompanyInfo"
          },
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "productName": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "articleNumber": {
            "type": "string"
          },
          "articleTitle": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "highlight": {
            "type": "string"
          },
          "relevanceScore": {
            "type": "number",
            "format": "float"
          },
          "dataSource": {
            "type": "string"
          },
          "supplementary": {
            "$ref": "#/components/schemas/SupplementaryInfo"
          }
        },
        "required": [
          "content",
          "contentType",
          "highlight",
          "id",
          "insuranceCompany",
          "productId",
          "productName",
          "relevanceScore",
          "supplementary"
        ]
      },
      "ServiceResponseSearchResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "statusCode": {
            "type": "integer",
            "format": "int32"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/SearchResponse"
          }
        },
        "required": [
          "statusCode",
          "success"
        ]
      },
      "SupplementaryInfo": {
        "type": "object",
        "properties": {
          "hasSurrenderValues": {
            "type": "boolean"
          },
          "hasPremiumExamples": {
            "type": "boolean"
          },
          "hasPriceIndices": {
            "type": "boolean"
          }
        },
        "required": [
          "hasPremiumExamples",
          "hasPriceIndices",
          "hasSurrenderValues"
        ]
      },
